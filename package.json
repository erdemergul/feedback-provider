{
  "name": "feedback-provider",
  "version": "1.0.0",
  "description": "A react component to get free feedback over feedbackclub.app.",
  "author": "erdemergul",
  "license": "MIT",
  "repository": "erdemergul/feedback-provider",
  "scripts": {
    "build": "tsup"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
