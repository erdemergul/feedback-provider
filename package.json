        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.8",
    "@types/react": "^16.8.0",
    "@types/react-dom": "^16.8.0",
    "react": "^16.8.0",
    "react-dom": "^16.8.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "homepage": "https://feedbackclub.app",
  "keywords": [
    "feedback",
    "feed",
    "club",
    "feedbackclub",
    "provider",
    "feedbackprovider",
